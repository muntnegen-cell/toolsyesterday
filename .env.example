# Kopieer naar .env.local en vul in. Commit .env.local NOOIT.

# --- App ---
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Supabase (Project Settings → API Keys) ---
NEXT_PUBLIC_SUPABASE_URL=https://xxxxxxxxxxxx.supabase.co
# Publishable key (sb_publishable_...) — of de legacy "anon" key
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_xxxxxxxxxxxx
# Secret key (sb_secret_...) — of de legacy "service_role" key. Alleen server-side!
SUPABASE_SECRET_KEY=sb_secret_xxxxxxxxxxxx

# --- Anthropic (console.anthropic.com → API Keys) ---
ANTHROPIC_API_KEY=sk-ant-xxxxxxxxxxxx
ANTHROPIC_MODEL=claude-sonnet-5

# --- Stripe (dashboard.stripe.com → Developers → API keys) ---
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_xxxxxxxxxxxx
STRIPE_SECRET_KEY=sk_test_xxxxxxxxxxxx
# Lokaal: output van `stripe listen --forward-to localhost:3000/api/webhook`
STRIPE_WEBHOOK_SECRET=whsec_xxxxxxxxxxxx
# Product "Volledig Rapport" — eenmalig €19,00 (EUR)
STRIPE_PRICE_ID_REPORT=price_xxxxxxxxxxxx
# Product "Pro Abonnement" — terugkerend €9,00 / maand (EUR)
STRIPE_PRICE_ID_PRO=price_xxxxxxxxxxxx

# --- Admin ---
# Kommagescheiden e-mailadressen met toegang tot /admin
ADMIN_EMAILS=jij@example.com
